# Waylit environment variables. Copy this file to .env.local and fill in what you need.
# Never commit .env.local or any file containing real values.
#
# Waylit runs with every value below left empty. Without keys it uses the
# fallback map and mock data. The final variable names are set when the first
# map provider and the app shell land (see docs/ROADMAP.md).

# Optional: Cesium ion access token for hosted 3D tiles. Restrict it by referrer in the Cesium ion dashboard.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Optional: Google Maps Platform API key for Google tiles, if the project adopts them.
# Restrict it by HTTP referrer and set a quota cap. Check Google's current terms first.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
