# Waylit environment variables. Copy this file to apps/web/.env.local and fill in what you need.
# Never commit .env.local or any file containing real values.
#
# Waylit runs with every value below left empty. Without keys it uses the
# fallback map (MapLibre with OpenFreeMap) and mock data.

# Optional: link to the source code shown in the app. Defaults to the upstream repository.
# Set it to your fork's URL if you deploy modified code.
NEXT_PUBLIC_WAYLIT_SOURCE_URL=

# Optional: Cesium ion access token. With it, production builds show Google Photorealistic
# 3D Tiles through Cesium ion. Restrict it to your site's origin in the Cesium ion dashboard.
# It ends up in the browser bundle, so never use a token you cannot restrict. Development
# builds still use the fallback map unless the address has ?map=cesium, to save the allowance.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
