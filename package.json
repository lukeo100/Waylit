{
  "name": "waylit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Open source 3D navigation for electric scooters and bicycles.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.28.0 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @waylit/web dev",
    "build": "pnpm --filter @waylit/web build",
    "start": "pnpm --filter @waylit/web start",
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
